{
  "about": "The MUI names scripts/check-mui-api.mjs fails on: what the move to MUI 9 and the MUI X 9 grid and charts took out. Removed props of Material components, slot props, grid options, and the class names of InputBase and the charts that MUI 9 no longer sets, so a stylesheet rule on one matches nothing. They sit in a JSON file because that check reads all of shared/ with no exception, and it does not read .json: in a script these rows would be hits on themselves.",
  "howToChange": "Add a row: name is what a person reads, pattern is the source of a regular expression that must match name, or the check refuses, and instead is what to write now. A pattern runs over a whole file, so \\s can cross a line break. A prop still valid on another component is matched on its own component only, through the attribute walk in the TextField and Typography rows. A false hit: narrow that row's pattern, or take the row out.",
  "rows": [
    { "name": "componentsProps", "pattern": "\\bcomponentsProps\\b", "instead": "slotProps" },
    { "name": "components={{", "pattern": "\\bcomponents=\\{\\{", "instead": "slots={{" },
    { "name": "<Grid item", "pattern": "<Grid\\s+item\\b", "instead": "<Grid size={...}>" },
    { "name": "GridToolbar", "pattern": "\\bGridToolbar\\w*", "instead": "showToolbar, or the grid's Toolbar parts" },
    { "name": "useDemoData", "pattern": "\\buseDemoData\\b", "instead": "rows and columns written in the page" },
    { "name": "pageSize=", "pattern": "\\bpageSize=", "instead": "initialState.pagination.paginationModel" },
    { "name": "rowsPerPageOptions", "pattern": "\\browsPerPageOptions\\b", "instead": "pageSizeOptions" },
    { "name": "disableSelectionOnClick", "pattern": "\\bdisableSelectionOnClick\\b", "instead": "disableRowSelectionOnClick" },
    { "name": "experimentalFeatures newEditingApi", "pattern": "\\bnewEditingApi\\b", "instead": "nothing: the new editing API is standard now" },
    { "name": "getActions", "pattern": "\\bgetActions\\b", "instead": "renderCell with GridActionsCell" },
    { "name": "valueGetter: (params", "pattern": "\\bvalueGetter:\\s*\\(params\\b", "instead": "valueGetter: (value, row) =>" },
    { "name": "InputProps=", "pattern": "\\bInputProps=", "instead": "slotProps={{ input: ... }}" },
    { "name": "InputLabelProps=", "pattern": "\\bInputLabelProps=", "instead": "slotProps={{ inputLabel: ... }}" },
    { "name": "FormHelperTextProps=", "pattern": "\\bFormHelperTextProps=", "instead": "slotProps={{ formHelperText: ... }}" },
    { "name": "SelectProps=", "pattern": "\\bSelectProps=", "instead": "slotProps={{ select: ... }}" },
    { "name": "<TextField inputProps", "pattern": "<TextField(?:\\s+[A-Za-z][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|\\{[^{}]*(?:\\{[^{}]*\\}[^{}]*)*\\}))?)*\\s+inputProps\\b", "instead": "slotProps={{ htmlInput: ... }}" },
    { "name": "params.InputProps", "pattern": "\\bparams\\.(?:InputProps|inputProps|InputLabelProps)\\b", "instead": "params.slotProps.input, htmlInput or inputLabel" },
    { "name": "PaperProps=", "pattern": "\\bPaperProps=", "instead": "slotProps={{ paper: ... }}" },
    { "name": "PopperProps=", "pattern": "\\bPopperProps=", "instead": "slotProps={{ popper: ... }}" },
    { "name": "TransitionComponent=", "pattern": "\\bTransitionComponent=", "instead": "slots={{ transition: ... }}" },
    { "name": "TransitionProps=", "pattern": "\\bTransitionProps=", "instead": "slotProps={{ transition: ... }}" },
    { "name": "BackdropComponent=", "pattern": "\\bBackdrop(?:Component|Props)=", "instead": "slots={{ backdrop: ... }} and slotProps={{ backdrop: ... }}" },
    { "name": "onBackdropClick=", "pattern": "\\bonBackdropClick=", "instead": "onClose, whose reason is backdropClick" },
    { "name": "primaryTypographyProps=", "pattern": "\\b(?:primary|secondary)TypographyProps=", "instead": "slotProps={{ primary: ... }} or secondary" },
    { "name": "<Typography paragraph", "pattern": "<Typography(?:\\s+[A-Za-z][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|\\{[^{}]*(?:\\{[^{}]*\\}[^{}]*)*\\}))?)*\\s+paragraph\\b", "instead": "a <p> or sx={{ marginBottom: 2 }}" },
    { "name": "renderTags=", "pattern": "\\brenderTags=", "instead": "renderValue=" },
    { "name": "ListboxProps=", "pattern": "\\bListbox(?:Props|Component)=", "instead": "slotProps={{ listbox: ... }} and slots={{ listbox: ... }}" },
    { "name": "'@mui/material/Hidden'", "pattern": "['\"]@mui/material/Hidden['\"]|import\\s*\\{[^}]*\\bHidden\\b[^}]*\\}\\s*from\\s*['\"]@mui/material['\"]", "instead": "sx={{ display: { xs: 'none', md: 'block' } }} or useMediaQuery" },
    { "name": "<Grid xs=", "pattern": "<Grid(?:\\s+(?!item\\b)[A-Za-z][\\w-]*(?:=(?:\"[^\"]*\"|'[^']*'|\\{[^{}]*(?:\\{[^{}]*\\}[^{}]*)*\\}))?)*\\s+(?:xs|sm|md|lg|xl)=", "instead": "<Grid size={{ xs: ... }}>" },
    { "name": "valueFormatter: (params", "pattern": "\\bvalueFormatter:\\s*\\(params\\b", "instead": "valueFormatter: (value, row) =>" },
    { "name": "valueSetter: (params", "pattern": "\\bvalueSetter:\\s*\\(params\\b", "instead": "valueSetter: (value, row) =>" },
    { "name": "MuiInputBase-inputMultiline", "pattern": "\\bMui(?:InputBase|Input|OutlinedInput|FilledInput)-input(?:Multiline|SizeSmall|AdornedStart|AdornedEnd|HiddenLabel)\\b", "instead": "the state class beside it, such as .MuiInputBase-multiline .MuiInputBase-input" },
    { "name": "MuiBarLabel-root", "pattern": "\\bMuiBarLabel-\\w+", "instead": "barClasses: .MuiBarChart-label" },
    { "name": "MuiLineElement-root", "pattern": "\\bMui(?:LineElement|AreaElement|MarkElement)-\\w+", "instead": "lineClasses: .MuiLineChart-line, -area or -mark" },
    { "name": "MuiRadarGrid-root", "pattern": "\\bMuiRadarGrid-\\w+", "instead": "radarClasses: .MuiRadarChart-gridRadial, -gridDivider or -gridStripe" }
  ]
}
