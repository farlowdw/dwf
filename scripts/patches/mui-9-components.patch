# mui-9-components.patch: the MUI 9 changes to the components that older sites hold as copies: Asterisk,
# BibRef, LC and the two grid illustrations. git apply skips these comment lines. One patch fits every copy
# that is as the older sites held it. A file a site lacks, or has changed, does not fit: shared:join prints
# the line with an --exclude for each, and its list names each changed file, to move to MUI 9 by hand.
#
# To change it: make the change in a copy of a site, then replace the diff below with its `git diff` of
# these files. Keep MUI X code out of it: shared/ holds none, so a component that imports MUI X, such as
# CustomToolbar, takes its change by hand. Paths are from a site's root.

diff --git a/src/components/Asterisk/index.jsx b/src/components/Asterisk/index.jsx
index 1e0970f..9331a70 100644
--- a/src/components/Asterisk/index.jsx
+++ b/src/components/Asterisk/index.jsx
@@ -20,7 +20,7 @@ export default function Asterisk({
 			title={children}
 			placement="top"
 			arrow
-			componentsProps={{
+			slotProps={{
 				tooltip: {
 					sx: {
 						color: '#E3E3E3',
@@ -28,7 +28,7 @@ export default function Asterisk({
 					},
 				},
 			}}>
-			<span style={{cursor, verticalAlign: 'super', marginLeft: '1px', fontSize: '0.75em'}}><Link color={colorMode == 'dark' ? '#48adf6' : '#0676c8'}>{symbol}</Link></span>
+			<span style={{cursor, verticalAlign: 'super', marginLeft: '1px', fontSize: '0.75em'}}><Link sx={{color: colorMode == 'dark' ? '#48adf6' : '#0676c8'}}>{symbol}</Link></span>
 		</Tooltip>
 	);
 }
